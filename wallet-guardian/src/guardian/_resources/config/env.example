# Copy to wallet-guardian/.env.local and fill values there. .env.local is gitignored.
# One Etherscan V2 key covers chainlist and later account, transaction, and log calls.
ETHERSCAN_API_KEY=
GOPLUS_API_KEY=
DEBANK_ACCESS_KEY=
ZERION_API_KEY=
ALCHEMY_API_KEY=
TENDERLY_ACCESS_KEY=
# User-wallet mainnet send. Default false. The agent never signs, even when this is true.
GUARDIAN_MAINNET_SEND=false
