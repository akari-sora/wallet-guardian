{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "One stored inflow-explanation revision. It does not change an alert, a severity, or a safety label.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amounts",
    "attempt_state",
    "calculation_version",
    "checkpoint_hashes",
    "contradiction_reasons",
    "control_inference",
    "established_facts",
    "event_id",
    "event_revision",
    "evidence_refs",
    "explained_effects",
    "explainer_id",
    "explainer_version",
    "facts",
    "funds_marked_safe",
    "gaps",
    "labels",
    "manifest_hash",
    "operator_control",
    "parties",
    "request_identity",
    "request_uuid",
    "residual",
    "retry_reason",
    "revision",
    "schema_version",
    "severity_changed",
    "supersedes",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": "guardian.explanation.v1"},
    "verdict": {
      "enum": ["MATCHES_OWN_REQUEST", "PARTIAL", "NO_MATCH", "UNVERIFIED", "NOT_APPLICABLE"]
    },
    "event_id": {"type": "string"},
    "event_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 0},
    "supersedes": {"type": ["integer", "null"]},
    "explainer_id": {"type": ["string", "null"]},
    "explainer_version": {"type": ["string", "null"]},
    "manifest_hash": {"type": ["string", "null"]},
    "calculation_version": {"type": ["string", "null"]},
    "attempt_state": {"enum": ["complete", "retry", "superseded"]},
    "retry_reason": {"type": ["string", "null"]},
    "funds_marked_safe": {"const": false},
    "severity_changed": {"const": false},
    "control_inference": {"const": "not_established"},
    "operator_control": {"const": "not_established"},
    "request_identity": {"type": ["string", "null"]},
    "request_uuid": {"type": ["string", "null"]},
    "facts": {"type": "object"},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "contradiction_reasons": {"type": "array", "items": {"type": "string"}},
    "established_facts": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "parties": {"type": "object"},
    "amounts": {"type": "object"},
    "explained_effects": {"type": "array"},
    "residual": {"type": "object"},
    "checkpoint_hashes": {"type": "object"},
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counterparty_identity", "label_source", "safety_assessment"],
      "properties": {
        "counterparty_identity": {"const": "unverified"},
        "label_source": {"const": "static_local_registry"},
        "safety_assessment": {"const": "not_established"}
      }
    }
  }
}
