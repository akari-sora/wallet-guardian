{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Persisted yield comparison. Not a live fetch record and not a notification send.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "live_fetch",
    "sent",
    "last_fetch_day",
    "policy",
    "sources",
    "cooldown",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "yield-state.v1"},
    "enabled": {"const": false},
    "live_fetch": {"const": false},
    "sent": {"const": false},
    "last_fetch_day": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
    "policy": {"$ref": "#/$defs/policy"},
    "sources": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/source_status"}
    },
    "cooldown": {"$ref": "#/$defs/cooldown"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_absolute_points", "min_relative", "risk_guarantee", "note"],
      "properties": {
        "min_absolute_points": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "min_relative": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "risk_guarantee": {"const": false},
        "note": {"const": "configurable product policy, not a risk guarantee"}
      }
    },
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cached", "etag", "last_modified", "content_hash", "read_status", "reason", "fetched_on"],
      "properties": {
        "cached": {"type": "boolean"},
        "etag": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
        "last_modified": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
        "content_hash": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
        "read_status": {
          "enum": ["ok", "not_modified", "cache_missing", "too_large", "rejected", "error"]
        },
        "reason": {"type": "string", "maxLength": 80},
        "fetched_on": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]}
      }
    },
    "cooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alerted_slots"],
      "properties": {
        "alerted_slots": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "identity", "observation", "yields", "terms", "comparison_state", "read_coverage"],
      "properties": {
        "schema_version": {"const": "yield-record.v1"},
        "identity": {"$ref": "#/$defs/identity"},
        "observation": {"$ref": "#/$defs/observation"},
        "yields": {"$ref": "#/$defs/yields"},
        "terms": {"$ref": "#/$defs/terms"},
        "comparison_state": {"$ref": "#/$defs/comparison_state"},
        "read_coverage": {"enum": ["partial", "unknown", "not_observable", "unsupported", "blocked"]}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "record_id",
        "pool_id",
        "chain",
        "protocol",
        "contracts",
        "mapping_status",
        "claimed_contracts"
      ],
      "properties": {
        "source": {"enum": ["defillama_pools", "binance_catalog_93", "explicit_body"]},
        "record_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "pool_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 80}]},
        "chain": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 64}]},
        "protocol": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 64}]},
        "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
        "mapping_status": {
          "enum": ["mapped", "unmapped", "spoofed", "campaign_required", "unsupported"]
        },
        "claimed_contracts": {
          "type": "array",
          "items": {"type": "string", "pattern": "^0x0{39}[0-9a-f]$"}
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "address", "mapped"],
      "properties": {
        "role": {"enum": ["pool", "receipt", "token"]},
        "address": {"type": "string", "pattern": "^0x0{39}[0-9a-f]$"},
        "mapped": {"const": true}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_at", "observed_at", "freshness", "content_hash"],
      "properties": {
        "published_at": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "observed_at": {"type": "string", "format": "date-time"},
        "freshness": {"enum": ["fresh", "not_modified", "unknown"]},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "yields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_base_yield",
        "reported_base_yield_canonical",
        "reported_incentive_reward_yield",
        "reported_incentive_reward_yield_canonical",
        "reported_total",
        "reported_total_canonical",
        "base_label",
        "incentive_label",
        "total_label",
        "unit",
        "apr_converted_to_apy",
        "compounding_model",
        "reward_tokens",
        "reward_token_status",
        "reward_token_count_known",
        "described_as_temporary",
        "duration_stated",
        "temporary_language"
      ],
      "properties": {
        "reported_base_yield": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "reported_base_yield_canonical": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}]},
        "reported_incentive_reward_yield": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "reported_incentive_reward_yield_canonical": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}]},
        "reported_total": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "reported_total_canonical": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}]},
        "base_label": {"const": "reported base yield"},
        "incentive_label": {"const": "reported incentive/reward yield"},
        "total_label": {"const": "reported total yield"},
        "unit": {"enum": ["APY", "APR", "unknown"]},
        "apr_converted_to_apy": {"const": false},
        "compounding_model": {"const": null},
        "reward_tokens": {
          "type": "array",
          "items": {"type": "string", "pattern": "^0x0{39}[0-9a-f]$"}
        },
        "reward_token_status": {"enum": ["unknown", "none_listed", "identified"]},
        "reward_token_count_known": {"type": "boolean"},
        "described_as_temporary": {"type": "boolean"},
        "duration_stated": {"type": "boolean"},
        "temporary_language": {"enum": ["not_described_as_temporary", "publisher_stated_duration"]}
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "deadlines",
        "deadline_status",
        "excerpt",
        "extraction_status",
        "provenance",
        "residual_conditions",
        "article_detail",
        "catalog_status",
        "links_not_followed"
      ],
      "properties": {
        "conditions": {"$ref": "#/$defs/conditions"},
        "deadlines": {"type": "array", "items": {"$ref": "#/$defs/deadline"}},
        "deadline_status": {"enum": ["extracted", "unknown"]},
        "excerpt": {"type": "string", "maxLength": 500},
        "extraction_status": {
          "enum": ["extracted", "unknown", "title_only", "ambiguous", "not_applicable"]
        },
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
        "residual_conditions": {"enum": ["none", "unknown"]},
        "article_detail": {"enum": ["not_applicable", "not_observable"]},
        "catalog_status": {"enum": ["not_applicable", "undocumented"]},
        "links_not_followed": {"type": "integer", "minimum": 0}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "minimum_amount", "minimum_unit", "lock_days"],
      "properties": {
        "status": {"enum": ["extracted", "unknown", "ambiguous"]},
        "minimum_amount": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}]},
        "minimum_unit": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 16}]},
        "lock_days": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "original", "timezone", "utc", "quote"],
      "properties": {
        "role": {"enum": ["start", "end", "unknown"]},
        "original": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "pattern": "^(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
        "utc": {"type": "string", "format": "date-time"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "quote", "source"],
      "properties": {
        "field": {"type": "string", "minLength": 1, "maxLength": 40},
        "quote": {"type": "string", "maxLength": 300},
        "source": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    },
    "comparison_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_valid_sample", "pending_sample", "last_alert", "dedupe", "comparison"],
      "properties": {
        "previous_valid_sample": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]},
        "pending_sample": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]},
        "last_alert": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/alert"}]},
        "dedupe": {"$ref": "#/$defs/dedupe"},
        "comparison": {"enum": ["baseline", "not_material", "pending", "sustained", "duplicate"]}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_hash",
        "observed_at",
        "freshness",
        "day",
        "semantic",
        "sustain_key",
        "reported_base_yield",
        "reported_base_yield_canonical",
        "reported_incentive_reward_yield",
        "reported_incentive_reward_yield_canonical",
        "reported_total",
        "reported_total_canonical",
        "unit"
      ],
      "properties": {
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "freshness": {"enum": ["fresh", "not_modified", "unknown"]},
        "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "semantic": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 400}]},
        "sustain_key": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 400}]},
        "reported_base_yield": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "reported_base_yield_canonical": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}]},
        "reported_incentive_reward_yield": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "reported_incentive_reward_yield_canonical": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}]},
        "reported_total": {"anyOf": [{"type": "number"}, {"type": "null"}]},
        "reported_total_canonical": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}]},
        "unit": {"enum": ["APY", "APR", "unknown"]}
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "wallet_id", "pool_id", "day", "semantic", "dedup_key"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 80},
        "kind": {"const": "yield_change"},
        "wallet_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "pool_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "semantic": {"type": "string", "minLength": 1, "maxLength": 400},
        "dedup_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dedupe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_semantic", "cooldown_day"],
      "properties": {
        "last_semantic": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 400}]},
        "cooldown_day": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]}
      }
    }
  }
}
