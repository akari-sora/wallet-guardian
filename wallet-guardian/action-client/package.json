{
  "name": "guardian-action-client",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43127 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test:canonical": "node src/canonical.test.mjs",
    "test:validation": "node --test src/plan-validation.test.mjs",
    "test:gate": "node src/gate.test.mjs",
    "test:api": "node --test src/private-task.test.mjs src/client-flow.test.mjs src/siwe-gate.test.mjs src/server/api.test.mjs src/lista-reread.test.mjs tests/*.test.mjs",
    "test:review": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0"
  }
}
