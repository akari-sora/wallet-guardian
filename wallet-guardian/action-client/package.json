{
  "name": "guardian-action-client",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43127 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test:canonical": "node src/canonical.test.mjs",
    "test:validation": "node --test src/plan-validation.test.mjs",
    "test:gate": "node src/gate.test.mjs",
    "test:api": "node --test --test-force-exit src/private-task.test.mjs src/client-flow.test.mjs src/siwe-gate.test.mjs src/server/api.test.mjs src/lista-reread.test.mjs tests/*.test.mjs",
    "test:review": "node --test --test-force-exit tests/*.test.mjs",
    "test:runtime": "node --test integration/d1-private-runtime.test.mjs",
    "test:wallets": "node --test --test-force-exit tests/wallet-discovery.test.mjs tests/wallet-selection.test.mjs tests/walletconnect-sdk.test.mjs tests/walletconnect-page.test.mjs",
    "test:wallets:artifact": "node --test --test-force-exit integration/wallets-artifact.test.mjs integration/walletconnect-artifact.test.mjs",
    "test:artifact:sendoff": "node --test --test-force-exit integration/sendoff-artifact.test.mjs"
  },
  "devDependencies": {
    "@walletconnect/sign-client": "2.25.0",
    "playwright-core": "1.59.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "wrangler": "4.148.0",
    "ws": "8.21.0"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@walletconnect/ethereum-provider": "2.25.0",
    "qrcode-generator": "2.0.4"
  }
}
