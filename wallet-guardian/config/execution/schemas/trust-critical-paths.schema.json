{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Review aid. Changing this list is itself a trust-critical review change. The list is not a boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "note", "categories", "paths"],
  "properties": {
    "schema_version": { "const": "guardian.trust_critical_paths.v1" },
    "note": { "const": "Changing this list is a trust-critical review change. The list is not a boundary." },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "paths"],
        "properties": {
          "name": { "type": "string" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "paths": { "type": "array", "items": { "type": "string" } }
  }
}
